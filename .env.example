NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
API_KEY_ENCRYPTION_SECRET=

AI_PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Global fallback. If provider-specific models below are empty, this is used.
AI_MODEL=

# OpenAI models. Use real API model names only; there is no official gpt-5.5 model.
OPENAI_MODEL=gpt-5.2
OPENAI_MODEL_CARD=gpt-5.2
OPENAI_MODEL_EXAMPLE=gpt-5.2
OPENAI_MODEL_OUTPUT=gpt-5.2
OPENAI_MODEL_GRADE=gpt-5.2
OPENAI_MODEL_CHAT=gpt-5.2
OPENAI_MODEL_VISION=gpt-5.2

# DeepSeek models
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_CARD=deepseek-chat
DEEPSEEK_MODEL_EXAMPLE=deepseek-chat
DEEPSEEK_MODEL_OUTPUT=deepseek-chat
DEEPSEEK_MODEL_GRADE=deepseek-chat
DEEPSEEK_MODEL_CHAT=deepseek-chat

# Optional if you want to try a reasoning model for supported tasks.
# DEEPSEEK_MODEL_CHAT=deepseek-reasoner
